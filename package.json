{
  "name": "prime-sales-full-stack-erp-app",
  "version": "1.0.0",
  "description": "The Prime Classes Sales & Management Full-Stack ERP Dashboard",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"nodemon server/index.js\" \"vite\"",
    "dev:server": "nodemon server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "sync": "node -e \"import('./server/syncEngine.js').then(m => m.triggerSync())\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "chart.js": "^4.4.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.475.0",
    "pdfkit": "^0.16.0",
    "pg": "^8.13.3",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1",
    "sqlite3": "^5.1.7",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
